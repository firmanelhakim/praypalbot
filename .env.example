# Copy to .env and fill in real values. .env is gitignored.
#   cp .env.example .env

# Telegram bot token from @BotFather. Required.
TELEGRAM_BOT_TOKEN=123456789:replace-with-your-token

# Gmail account used to send error alerts. Optional — if SENDER_EMAIL or
# SENDER_PASSWORD is unset, send_email() logs a warning and returns False
# instead of raising, so the bot still runs.
SENDER_EMAIL=you@example.com

# A Google *app password*, not your account password.
# https://support.google.com/accounts/answer/185833
SENDER_PASSWORD=xxxx xxxx xxxx xxxx

# Comma-separated list of alert recipients.
RECIPIENTS=you@example.com
